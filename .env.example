# Public canonical origin, embedded at build time. Rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://www.erkdynamics.com

# Optional ownership tokens from Google Search Console / Bing Webmaster Tools.
# Public verification values, not API keys. Leave blank until supplied by the owner.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Form mail is configured on the PHP host, not by Next.js.
# See docs/DEPLOYMENT.md and public/send.php.
