{
  "name": "erk-dynamics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint src scripts tests eslint.config.mjs --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:php": "node scripts/test-php.mjs && node scripts/test-php-http.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "dist": "next build && node scripts/make-dist.mjs && node scripts/check-export.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "node scripts/verify-deploy.mjs",
    "assets:map": "node scripts/make-world-map.mjs",
    "assets:thumbnails": "node scripts/make-home-thumbs.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "assets:social": "node scripts/make-social-image.mjs"
  },
  "dependencies": {
    "globe.gl": "^2.46.1",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.0",
    "world-atlas": "^2.0.2"
  },
  "description": "ERK Dynamics corporate website — static Next.js export with a PHP enquiry endpoint.",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
